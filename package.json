{
  "name": "dsh-local-bili-summary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "B 站视频一键总结：本地转写出转录，再生成一图读懂 PNG 与解析 md",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.py",
    "scripts/*.ps1",
    "references/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

